{
  "name": "@pi-app/pi-host",
  "private": true,
  "version": "0.1.0",
  "description": "Local Pi SDK sidecar for Pi App",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "tsc --noEmit --project tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify:rpc-contract": "npm run build && node dist/scripts/verify-rpc-contract.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
